# ─────────────────────────────────────────────────────────────
# MONETA — variables d'environnement (copier en .env et compléter)
# Ne JAMAIS committer le fichier .env : il contient des secrets.
# ─────────────────────────────────────────────────────────────

# Base de données (obligatoire)
# Rôle d'exécution SANS BYPASSRLS (soumis aux politiques Row Level Security)
DATABASE_URL=postgres://moneta_app:CHANGEZ_MOI@localhost:5432/moneta
# Rôle propriétaire, utilisé uniquement pour les migrations (npm run db:migrate)
MIGRATION_DATABASE_URL=postgres://moneta_owner:CHANGEZ_MOI@localhost:5432/moneta
# Optionnel : taille du pool, et désactivation des requêtes préparées (pooler Supabase en mode transaction)
# DATABASE_POOL_MAX=10
# DATABASE_DISABLE_PREPARE=true

# Application (obligatoire)
APP_URL=http://localhost:3000
# Nom affiché (modifiable)
NEXT_PUBLIC_APP_NAME=MONETA
# Clé de chiffrement des secrets stockés (jetons bancaires) — 32 caractères minimum, aléatoire
# Générer : openssl rand -base64 48
APP_ENCRYPTION_KEY=

# Espaces de démonstration temporaires depuis la page de connexion
ALLOW_DEMO_ACCOUNTS=true

# Conseiller IA et analyse de tickets par vision (optionnel) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut claude-opus-5-5)
# AI_MODEL=claude-opus-5-5

# E-mails : réinitialisation du mot de passe (optionnel mais recommandé en production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MONETA <no-reply@example.com>"

# Notifications push Web (optionnel) — générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Tâche planifiée quotidienne (/api/cron/daily) — secret partagé avec le planificateur (Vercel Cron…)
CRON_SECRET=

# Connexion bancaire DSP2 via Powens (optionnel, contrat requis) — voir docs/BANQUE.md
# Valeurs fournies par la console Powens. Un domaine de bac à sable (sandbox) est distinct du domaine de production.
# Requiert aussi APP_ENCRYPTION_KEY (chiffrement des jetons) et APP_URL (adresse de retour de la webview).
POWENS_DOMAIN=            # ex. « monappli-sandbox » ou « monappli-sandbox.biapi.pro »
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
# Clé de signature HMAC des webhooks (console Powens). Si définie, toute requête non signée est refusée.
# Sinon, les webhooks sont authentifiés par le jeton utilisateur (en-tête Authorization: Bearer).
POWENS_WEBHOOK_SECRET=
# Tests automatisés uniquement (serveur Powens simulé). Ne JAMAIS définir en production.
# POWENS_API_BASE_OVERRIDE=

# Tests uniquement : assouplit les limites de débit (laisser vide / 1 en production)
# RATE_LIMIT_MULTIPLIER=1
